/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src https://us.i.posthog.com; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=15552000
  Cache-Control: public, no-transform, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, no-transform, max-age=86400
